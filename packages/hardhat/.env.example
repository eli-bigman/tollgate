# Template for Hardhat environment variables.
# Copy to .env and fill in the values before deploying.

# ── Alchemy API Keys ──────────────────────────────────────────────────────────
# Used for Base Sepolia RPC (primary deployment target)
ALCHEMY_BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Used for other networks (Sepolia, Mainnet, etc.)
ALCHEMY_API_KEY=

# ── Block Explorer API Keys ───────────────────────────────────────────────────
# BaseScan API key — required to verify L2Registrar on sepolia.basescan.org
# Get one at: https://basescan.org/myapikey
BASESCAN_API_KEY=

# Etherscan V2 API key — used for all non-Base networks
ETHERSCAN_V2_API_KEY=

# ── Durin / ENS Addresses ─────────────────────────────────────────────────────
# L2 Registry deployed via durin.dev (DURIN_SETUP.md Step 3)
DURIN_L2_REGISTRY=0x

# L2 Registrar — set AFTER running: npx hardhat deploy --network baseSepolia --tags L2Registrar
DURIN_L2_REGISTRAR=0x

# ── Deployer Key ──────────────────────────────────────────────────────────────
# Do NOT fill this manually — run `yarn generate` or `yarn account:import` instead.
# The encrypted key is written to DEPLOYER_PRIVATE_KEY_ENCRYPTED automatically.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=
